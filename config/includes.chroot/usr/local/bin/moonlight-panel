#!/bin/sh
# The settings menu, opened from inside the graphical session with Ctrl+Alt+M.
#
# Without this the menus were only reachable by quitting Moonlight, which is
# not obvious and is impossible mid-stream -- so there was no way to install
# the system or change anything once the appliance had started.
#
# shellcheck source=./moonlight-common
. /usr/local/bin/moonlight-common

[ -n "${DISPLAY:-}" ] || export DISPLAY=:0

panel_window() {
	xdotool search --class -- '^moonlight-panel$' 2>/dev/null | head -1
}

# One panel at a time.  A second Ctrl+Alt+M raises the one already open
# instead of stacking terminals on top of each other.
LOCK=/tmp/moonlight-panel.lock
if ! mkdir "$LOCK" 2>/dev/null; then
	wid="$(panel_window)"
	if [ -n "$wid" ]; then
		xdotool windowactivate "$wid" 2>/dev/null
		exit 0
	fi
	# No window yet.  That is either a panel that was killed rather than
	# closed -- without this the key would silently stop working for the
	# rest of the session -- or one that started a moment ago and has not
	# mapped its window yet.  Only the first deserves the lock taken off it.
	if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
		rmdir "$LOCK" 2>/dev/null
		mkdir "$LOCK" 2>/dev/null || exit 0
	else
		exit 0
	fi
fi

# Moonlight grabs the X keyboard while streaming, so a window opened over the
# top of it would come up unusable -- visible, focused, and receiving nothing.
# Iconifying Moonlight makes SDL drop the grab; it comes back afterwards.
hidden=$(xdotool search --class -- '^moonlight$' 2>/dev/null)
for w in $hidden; do
	xdotool windowminimize "$w" 2>/dev/null || true
done

restore() {
	for w in $hidden; do
		xdotool windowactivate "$w" 2>/dev/null || true
	done
	rmdir "$LOCK" 2>/dev/null
}
trap restore EXIT INT TERM HUP

# Moonlight's window is fullscreen, and openbox keeps fullscreen windows in
# the topmost layer -- an ordinary window would open behind the stream and
# look like nothing happened.  The panel is made fullscreen too (see
# /etc/xdg/openbox/rc.xml) so it lands in the same layer, then raised.
(
	i=0
	while [ $i -lt 40 ]; do
		wid="$(panel_window)"
		if [ -n "$wid" ]; then
			xdotool windowactivate "$wid" 2>/dev/null
			xdotool windowraise "$wid" 2>/dev/null
			break
		fi
		i=$((i + 1))
		sleep 0.1
	done
) &

# Not exec'd: the trap above has to run when the menu closes, or the lock
# outlives the panel and Ctrl+Alt+M never works again for the rest of the
# session.
#
# -fa/-fs use the TrueType font we already ship for Qt, so no bitmap font
# package is needed.  C.UTF-8 always exists and keeps whiptail's box drawing
# characters intact.
env LANG=C.UTF-8 xterm \
	-class moonlight-panel \
	-title "Moonlight OS settings" \
	-fa "DejaVu Sans Mono" -fs 13 \
	-bg black -fg white -b 16 +sb -en UTF-8 \
	-e /usr/local/bin/moonlight-menu --in-x
