#!/bin/sh
# The settings menu, opened from inside the graphical session with Ctrl+Alt+M.
#
# Without this the menus were only reachable by quitting the client, which is
# not obvious and is impossible mid-stream -- so there was no way to install
# the system or change anything once the appliance had started.
#
# This used to be the most contorted script in the image, and all of it was
# X11's doing.  For the record, since the shape of the old version explains
# why several other things existed:
#
#   * the client grabbed the X keyboard while streaming, so the window manager
#     never saw Ctrl+Alt+M -- hence a triggerhappy daemon reading /dev/input,
#     evdev rules listing the key twice for AZERTY, and a root-to-user hand-off
#     script to get a DISPLAY back;
#   * a window opened over the grab came up focused and receiving nothing, so
#     the client had to be iconified first to make SDL drop the grab, then
#     restored afterwards from an EXIT trap;
#   * fullscreen windows sit in a layer of their own under openbox, so the
#     panel needed its own openbox rule plus xdotool activate/raise polling to
#     land in front rather than behind the stream.
#
# A compositor binding is evaluated before the key reaches any client, and a
# placement rule puts the window in front, so none of the above is needed. The
# script is now: take a lock, run the menu in a terminal.
#
# shellcheck source=./moonlight-common
. /usr/local/bin/moonlight-common

# One panel at a time.  A second Ctrl+Alt+M focuses the one already open
# instead of stacking terminals on top of each other.
LOCK=/tmp/moonlight-panel.lock
if ! mkdir "$LOCK" 2>/dev/null; then
	if swaymsg '[app_id="moonlight-panel"] focus' >/dev/null 2>&1; then
		exit 0
	fi
	# No window.  That is either a panel that was killed rather than closed
	# -- without this the key would silently stop working for the rest of
	# the session -- or one that started a moment ago and has not mapped
	# its window yet.  Only the first deserves the lock taken off it.
	if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
		rmdir "$LOCK" 2>/dev/null
		mkdir "$LOCK" 2>/dev/null || exit 0
	else
		exit 0
	fi
fi

trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM HUP

# Not exec'd: the trap above has to run when the menu closes, or the lock
# outlives the panel and Ctrl+Alt+M never works again for the rest of the
# session.
#
# C.UTF-8 always exists and keeps whiptail's box drawing characters intact.
# foot is told the app_id so the sway rules in /etc/sway/config match it.
env LANG=C.UTF-8 foot \
	--app-id=moonlight-panel \
	--title="Moonlight OS settings" \
	--font="DejaVu Sans Mono:size=13" \
	-- /usr/local/bin/moonlight-menu --in-session
