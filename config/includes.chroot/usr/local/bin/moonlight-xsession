#!/bin/sh
# The X client that `startx` runs.  When this exits, X shuts down and
# control returns to moonlight-session.
#
# shellcheck source=./moonlight-common
. /usr/local/bin/moonlight-common

mlos_load

# No screen blanking, no bell, no visible cursor while idle.
xset s off
xset s noblank
xset -dpms
xset -b
unclutter -idle 3 -root &

# Carry the console keyboard layout into X.
moonlight-region --apply-x

# Trackpad scroll direction.
moonlight-input --apply

# Record the real output layout so the (TTY-side) display menu has
# something accurate to offer next time it runs.
mkdir -p "$MLOS_STATE"
xrandr --query > "$MLOS_SNAPSHOT" 2>/dev/null || true

# Rebuild the layout for whatever is plugged in right now.
moonlight-displays --apply

# ...and keep doing it.  A laptop gets carried to a monitor and away again;
# neither should need the menu.
moonlight-hotplug >> "$MLOS_STATE/hotplug.log" 2>&1 &

# Low-battery warnings, drawn over the stream.  Exits by itself on a machine
# with no battery, so there is nothing to guard here.
moonlight-battery >> "$MLOS_STATE/battery.log" 2>&1 &

# A window manager is required: Moonlight asks for fullscreen over EWMH,
# and without a WM that request goes nowhere.
openbox &
sleep 1

# SDL puts the RandR *primary* output at display index 0, and
# moonlight-displays marks the chosen screen primary -- so pinning the stream
# to index 0 lands it on the right monitor.
#
# Only do this when a screen was actually chosen.  Forcing index 0
# unconditionally is a guess, and on a multi-head machine it sends the stream
# to whichever output RandR happens to list first -- which looks exactly like
# a black screen on the monitor you are watching.
if [ -n "$MOONLIGHT_OUTPUT" ]; then
	export SDL_VIDEO_FULLSCREEN_DISPLAY=0
fi

# Nudge the Qt launcher window onto the chosen monitor too (the stream
# window is handled by SDL above; this is just the browse/pair UI).
if [ -n "$MOONLIGHT_OUTPUT" ]; then
	(
		geom=$(xrandr --query | awk -v o="$MOONLIGHT_OUTPUT" \
			'$1==o && $2=="connected" {for(i=3;i<=NF;i++) if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) {print $i; exit}}')
		x=${geom#*+}; y=${x#*+}; x=${x%%+*}
		[ -n "$x" ] && [ -n "$y" ] || exit 0
		i=0
		while [ $i -lt 60 ]; do
			# Anchored: an unanchored "selene" would be a substring match.
			# settings panel's own window class.
			wid=$(xdotool search --class -- '^selene$' 2>/dev/null | head -1)
			if [ -n "$wid" ]; then
				xdotool windowmove "$wid" "$x" "$y" 2>/dev/null
				exit 0
			fi
			i=$((i + 1))
			sleep 0.25
		done
	) &
fi

# Moonlight runs in a loop so the Ctrl+Alt+M panel can restart it in place.
# Video settings are read once at start-up, and tearing down the whole X
# session to change one would dump the user back on the console.
rm -f "$MLOS_STATE/restart"
while :; do
	# Backgrounded only so the pid can be recorded; the wrapper execs
	# selene, so this pid stays the one to signal.  Killing by pid beats
	# matching a command line, which catches innocent bystanders.
	/usr/local/bin/moonlight &
	ml_pid=$!
	echo "$ml_pid" > "$MLOS_STATE/moonlight.pid"
	wait "$ml_pid"
	rm -f "$MLOS_STATE/moonlight.pid"

	[ -e "$MLOS_STATE/restart" ] || break
	rm -f "$MLOS_STATE/restart"
	mlos_load
	moonlight-region --apply-x
	moonlight-displays --apply
done
