#!/bin/sh
# Watch for monitors being plugged in and unplugged, and rearrange to suit.
#
# This is a laptop appliance: it gets carried to a monitor, plugged in, and
# carried away again, and none of that should need a menu.  Started by
# moonlight-xsession and dies with the session.
#
# shellcheck source=./moonlight-common
. /usr/local/bin/moonlight-common

[ -n "${DISPLAY:-}" ] || exit 0

INTERVAL="${MLOS_HOTPLUG_INTERVAL:-2}"

# Just the names and their connected/disconnected state -- resolution changes
# made from the menu must not look like a hotplug and start a loop.
#
# --current is load-bearing, not a micro-optimisation.  A plain "xrandr
# --query" asks the server to re-probe every connector, which means a DDC
# transaction per output; on a machine with one panel and six dead DP/HDMI
# connectors those six all have to time out before the call returns.  The X
# server is single-threaded, so that is the whole display frozen -- measured
# at 200 ms per call on the Miix, once every INTERVAL seconds, for as long as
# the session is up.  During a stream that reads as a regular half-second
# stutter every few seconds, and it looks exactly like a network fault, which
# is where the hunt for it started.
#
# --current reads the state the server already holds instead of re-probing
# (XRRGetScreenResourcesCurrent rather than XRRGetScreenResources): 33x
# cheaper here, 3 jiffies against 100 for the same five calls.  It still sees
# hotplugs, because it is not the polling that discovers them -- the kernel
# raises a DRM uevent, the modesetting driver handles it and updates the
# server's own view, and this loop is only here to notice that it changed.
state() {
	xrandr --query --current 2>/dev/null \
		| awk '/ connected| disconnected/ {print $1, $2}'
}

log() {
	printf '%s moonlight-hotplug: %s\n' "$(date '+%H:%M:%S')" "$1"
}

last="$(state)"

while :; do
	sleep "$INTERVAL"
	now="$(state)"

	# An empty read means the X server went away; so should we.
	[ -n "$now" ] || exit 0
	[ "$now" = "$last" ] && continue

	log "screens changed"
	last="$now"

	# The screen actually in use before this change, which is not always
	# the one that was asked for.
	before="$(cat "$MLOS_STATE/current-output" 2>/dev/null)"

	# Settle: a monitor coming up over DisplayPort can report connected
	# before its mode list is readable, and building a layout from half of
	# an EDID produces a blank screen.
	sleep 1

	moonlight-displays --apply

	after="$(cat "$MLOS_STATE/current-output" 2>/dev/null)"
	if [ "$after" != "$before" ]; then
		# Either the screen it was drawing on went away, or the one you
		# actually asked for came back.  Moonlight picks its display once,
		# at start-up, so it has to be restarted to follow.
		log "moonlight moving from ${before:-none} to ${after:-none}, restarting it"
		mlos_restart_moonlight
	else
		log "layout reapplied, moonlight stays on ${after:-auto}"
	fi
done
